{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noEmit": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "skipLibCheck": true, "types": ["vite/client", "node"],
    "paths": { "vue": ["./node_modules/vue"] }
  },
  "include": ["src/**/*.ts", "../../web/src/**/*.ts", "../../web/src/**/*.vue", "vite.config.ts"]
}
