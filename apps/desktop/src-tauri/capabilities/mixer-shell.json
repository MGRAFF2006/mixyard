{
  "identifier": "mixer-shell",
  "description": "Shared console over distinct local CSRF or native paired TLS transports. Native credentials stay in the platform vault. Only bounded canonical management commands; no remote origins or generic shell/filesystem bridge.",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-shell-status",
    "allow-connect-runtime",
    "allow-disconnect-runtime",
    "allow-hide-mixer",
    "allow-quit-ui",
    "allow-console-request",
    "allow-set-compact",
    "allow-update-tray-context",
    "allow-take-ui-action",
    "allow-paired-list",
    "allow-paired-pair",
    "allow-paired-open",
    "allow-paired-request",
    "allow-paired-disconnect",
    "allow-paired-forget",
    "allow-paired-revoke"
  ]
}
